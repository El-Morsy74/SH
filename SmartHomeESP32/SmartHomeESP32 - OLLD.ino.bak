#include <WiFi.h>
#include <WebServer.h>

// ==========================================
// 1. WI-FI CONFIGURATION
// ==========================================
// Enter your home Wi-Fi credentials here:
const char* ssid     = "M02";
const char* password = "mm##MM19071907";

// Static IP Configuration:
// Change local_IP to a unique IP address on your network (e.g. 192.168.100.200)
IPAddress local_IP(192, 168, 100, 200); 
IPAddress gateway(192, 168, 100, 1);    // Your router's IP address
IPAddress subnet(255, 255, 255, 0);      // Subnet mask
IPAddress primaryDNS(192, 168, 100, 1); // Primary DNS (usually your router)
IPAddress secondaryDNS(8, 8, 8, 8);    // Secondary DNS (Google)

// Fallback Access Point Settings:
// If the ESP32 cannot connect to your home Wi-Fi, it will broadcast its own network.
// Connect your phone/PC to "Smart-Home-Hub" to control the relays offline.
const char* ap_ssid     = "Smart-Home-Hub";
const char* ap_password = "password123"; // Must be at least 8 characters

// Create WebServer object on port 80
WebServer server(80);

// ==========================================
// 2. HARDWARE RELAY CONFIGURATION
// ==========================================
// 30-Pin ESP32 safe output pins:
// IN1 -> GPIO 25 (Relay 1)
// IN2 -> GPIO 26 (Relay 2)
// IN3 -> GPIO 27 (Relay 3)
// IN4 -> GPIO 32 (Relay 4)
const int RELAY_PINS[4] = {25, 26, 27, 32};

// Relay states (0 = OFF, 1 = ON)
// In a low-level trigger relay:
// State 1 (ON)  -> Write LOW to pin
// State 0 (OFF) -> Write HIGH to pin
int relayStates[4] = {0, 0, 0, 0};

// ==========================================
// 3. EMBEDDED DASHBOARD PAGE (HTML/CSS/JS)
// ==========================================
const char INDEX_HTML[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Home Hub</title>
    <style>
        :root {
            --bg-color: #0b0f19;
